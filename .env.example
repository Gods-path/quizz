# --- Supabase ---------------------------------------------------------------
# Tableau de bord Supabase > Project Settings > API Keys

# L'adresse de votre projet (visible par le navigateur, ce n'est pas un secret)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# La cle PUBLIQUE ("publishable", commence par sb_publishable_).
# Elle part dans le navigateur : c'est normal et sans danger.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# La cle SECRETE ("secret", commence par sb_secret_).
# ELLE NE DOIT JAMAIS ETRE PARTAGEE NI ENVOYEE AU NAVIGATEUR.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# --- Espace formateur -------------------------------------------------------
# Le mot de passe que vous taperez sur /formateur. Changez-le !
ADMIN_PASSWORD=changez-moi

# --- Facultatif -------------------------------------------------------------
# Adresse utilisee dans le QR code. Laissez vide : l'application prend
# automatiquement l'adresse de la page en cours.
# NEXT_PUBLIC_APP_URL=https://mon-quiz.vercel.app
